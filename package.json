{
  "name": "nodefire",
  "version": "7.1.1",
  "description": "A promise-centric Firebase library for NodeJS",
  "main": "built/index.js",
  "types": "built/index.d.ts",
  "files": [
    "/built"
  ],
  "engines": {
    "node": ">=22.0"
  },
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "update": "yarn up -R '*' && yarn dedupe --strategy highest",
    "latest": "yarn npm-check-updates -i -m --packageManager yarn --install never && yarn install",
    "upgrade": "reviewable-upgrade",
    "lint": "eslint src/*.ts tests/*.ts tests/*.mjs",
    "check-types": "tsc --noEmit --skipLibCheck && tsc --project tests/tsconfig.json --skipLibCheck",
    "build": "tsc",
    "test": "yarn build && node --test tests/cache.mjs",
    "prepack": "tsc"
  },
  "repository": "https://github.com/Reviewable/nodefire",
  "keywords": [
    "Firebase",
    "api",
    "promise"
  ],
  "author": "Piotr Kaminski <piotr@ideanest.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Reviewable/nodefire/issues"
  },
  "homepage": "https://github.com/Reviewable/nodefire",
  "dependencies": {
    "firebase-admin": "14.x",
    "firebase-childrenkeys": "^3.3.0",
    "firefight": "^1.3.0",
    "lodash": "^4.17.21",
    "lru-cache": "11.x",
    "safe-timers": "^1.1.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.191",
    "@types/safe-timers": "^1.1.0",
    "eslint": "^10.7.0",
    "npm-check-updates": "^22.2.9",
    "reviewable-configs": "Reviewable/reviewable-configs#master",
    "typescript": "^5.4.0"
  }
}
